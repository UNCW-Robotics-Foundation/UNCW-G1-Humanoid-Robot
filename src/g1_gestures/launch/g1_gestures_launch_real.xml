<launch>
  <node pkg="g1_gestures" exec="g1_gesture_control" name="robot_gestures" >
  	<param name="is_sim" value="false" />
  	<param name="use_xbox" value="false" />
  </node>
  <node pkg="g1_gestures" exec="robot_status" name="robot_status" />
  <node pkg="g1_gestures" exec="hands_controller" name="robot_hands" />
  <node pkg="ros2_stark_controller" exec="stark_node" name="stark_node" >
	<param from="$(find-pkg-share ros2_stark_controller)/config/params_v2_double.yaml" />
  </node>
</launch>
