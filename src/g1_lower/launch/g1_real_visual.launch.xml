<launch>
  <let name="robot_description_content" value="$(command '$(find-exec xacro) $(find-pkg-share g1_lower)/urdf/g1_29dof_mode_15_brainco_hand.urdf')" />
  
  <node pkg="g1_lower" exec="lowstate_jointstate_bridge" name="ls_bridge" />
  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="both">
    <param name="robot_description" value="$(var robot_description_content)" />    
  </node>
  <node pkg="tf2_ros" exec="static_transform_publisher" args="--x 0.0 --y 0.0 --z 0.0 --roll 0 --pitch 0 --yaw 0 --frame-id d435_link --child-frame-id camera_link"/>
  <node pkg="tf2_ros" exec="static_transform_publisher" args="--x 0.02 --y 0.0 --z 0.05 --roll 0 --pitch 0 --yaw 0 --frame-id left_base_link --child-frame-id left_hand_ref"/>

 <node pkg="rviz2" exec="rviz2" output="log" args="-d $(find-pkg-share g1_lower)/urdf/g1_cam.rviz"/>
        
</launch>
